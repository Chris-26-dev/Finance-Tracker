# Copy to .env.local and fill in values. Never commit .env.local.

# Postgres connection string (Neon). Use a development branch, not production.
DATABASE_URL=

# Optional: base URL of the API. Defaults to the site's own origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com). The publishable key is needed twice:
# NEXT_PUBLIC_ for the Next.js app and plain for the Hono API middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: seeding demo data for ONE development user (see README).
# ALLOW_DESTRUCTIVE_SEED=true
# SEED_USER_ID=user_...
